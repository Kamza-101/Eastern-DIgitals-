<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="Group_9.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Group 9 - Eastern Digital</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
    <style>
  
    .ios-navbar {
        background-color: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border-bottom: 1px solid gainsboro;
        position: sticky;
        top: 0;
        z-index: 1000;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }
    .ios-nav-brand {
        background: linear-gradient(90deg, royalblue, mediumorchid);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 900;
        font-size: 1.4rem;
        letter-spacing: -0.5px;
    }
    .ios-nav-link {
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 1px;
        color: dimgray !important;
        transition: color 0.3s ease;
        padding: 0.5rem 1rem !important;
        text-decoration: none; 
    }
    .ios-nav-link:hover {
        color: royalblue !important;
    }
    </style>
</head>
<body>
    <form id="form1" runat="server">
    <nav class="navbar navbar-expand-lg ios-navbar py-3">
        <div class="container">
            <a class="navbar-brand ios-nav-brand" href="Default.aspx">EasternDigital</a>
            
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto gap-2">
                    
                    <asp:PlaceHolder ID="phGuestNav" runat="server">
                        <li class="nav-item"><a class="nav-link ios-nav-link" href="Default.aspx">HOME</a></li>
                        <li class="nav-item"><a class="nav-link ios-nav-link" href="BrowseServices.aspx">BROWSE SERVICES</a></li>
                        <li class="nav-item"><a class="nav-link ios-nav-link" href="Register.aspx">REGISTER</a></li>
                        <li class="nav-item"><a class="nav-link ios-nav-link" href="Login.aspx">LOGIN</a></li>
                    </asp:PlaceHolder>

                    <asp:PlaceHolder ID="phMemberNav" runat="server" Visible="false">
                        <li class="nav-item"><a class="nav-link ios-nav-link" href="Default.aspx">HOME</a></li>
                        <li class="nav-item"><a class="nav-link ios-nav-link" href="BrowseServices.aspx">BROWSE SERVICES</a></li>
                        <li class="nav-item"><a class="nav-link ios-nav-link" href="Bookings.aspx">MY BOOKINGS</a></li>
                        <li class="nav-item"><a class="nav-link ios-nav-link" href="ViewCart.aspx">VIEW CART</a></li>
                    </asp:PlaceHolder>

                    <asp:PlaceHolder ID="phProviderNav" runat="server" Visible="false">
                        <li class="nav-item"><a class="nav-link ios-nav-link" href="ProviderDashboard.aspx">DASHBOARD</a></li>
                        <li class="nav-item"><a class="nav-link ios-nav-link" href="ManageServices.aspx">MANAGE SERVICES</a></li>
                    </asp:PlaceHolder>

                    <asp:PlaceHolder ID="phAdminNav" runat="server" Visible="false">
                      <li class="nav-item"><a class="nav-link ios-nav-link" href="AdminDashboard.aspx">DASHBOARD</a></li>
                      <li class="nav-item"><a class="nav-link ios-nav-link" href="Reports.aspx">SYSTEM REPORTS</a></li>
                        <li class="nav-item"><a class="nav-link ios-nav-link" href="SystemLogs.aspx">SYSTEM LOGS</a></li>
                    </asp:PlaceHolder>

                    <asp:PlaceHolder ID="phLogoutNav" runat="server" Visible="false">
                        <li class="nav-item">
                            <asp:LinkButton ID="btnLogout" runat="server" 
                                CssClass="nav-link ios-nav-link text-danger" 
                                OnClick="btnLogout_Click" 
                                CausesValidation="false">LOGOUT</asp:LinkButton>
                        </li>
                    </asp:PlaceHolder>

                </ul>
            </div>
        </div>
    </nav>

        <div class="container">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </div>

        <footer class="footer mt-5 py-3 border-top">
            <div class="container text-center">
                <p class="text-muted">&copy; <%= DateTime.Now.Year %> EasternDigital. All rights reserved.</p>
            </div>
        </footer>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
